<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>D-Pay</title>
<style>
*{box-sizing:border-box;font-family:Roboto,Arial}body{margin:0;background:#F5F6F8;padding-bottom:80px}
.top{display:flex;align-items:center;padding:20px;gap:12px}
.avatar{width:45px;height:45px;border-radius:50%;background:#FFE5D1;display:flex;align-items:center;justify-content:center;font-size:22px}
.wallet{background:#20232B;color:white;margin:0 20px;padding:22px;border-radius:22px}
.wallet h1{font-size:30px;margin:5px 0 20px}
.btn{background:#F36B21;color:white;border:none;padding:12px 18px;border-radius:12px;font-weight:bold;width:100%;cursor:pointer}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:20px}
.card{background:white;padding:18px;border-radius:18px;cursor:pointer}
.card span{font-size:28px}
.activity{background:white;margin:0 20px 10px;padding:12px;border-radius:14px;display:flex;justify-content:space-between;align-items:center}
.page{display:none;padding:0 20px}.page.active{display:block}
.nav{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;justify-content:space-around;padding:12px 0;border-top:1px solid #eee}
.nav button{border:none;background:none;font-size:14px;cursor:pointer}.nav button.active{color:#F36B21;font-weight:bold}
input,select{width:100%;padding:13px;border-radius:14px;border:none;background:white;margin:8px 0}
.chip{padding:8px 16px;border-radius:20px;border:1px solid #ddd;background:white;cursor:pointer;margin:4px}.chip.sel{background:#FFE5D1;border-color:#F36B21}
.plan{background:white;padding:12px;border-radius:14px;margin:8px 0;cursor:pointer}.plan.sel{border:2px solid #F36B21}
</style></head><body>

<div id="home" class="page active">
<div class="top"><div class="avatar">👛</div><div style="flex:1"><div style="color:grey">Welcome back,</div><b style="font-size:19px">D-Pay User</b></div><div>🔔</div></div>
<div class="wallet"><div style="color:#ccc">Total Wallet Balance</div><h1>₦25,000.00</h1><button class="btn" onclick="alert('Demo - Fund Wallet coming soon')">+ Fund Wallet</button></div>
<h2 style="padding:0 20px">Our Services</h2>
<div class="grid">
<div class="card" onclick="showPage('data')"><span>📶</span><br><b>Buy Data</b></div>
<div class="card" onclick="alert('Airtime coming soon')"><span>📱</span><br><b>Buy Airtime</b></div>
<div class="card" onclick="alert('Cable TV coming soon')"><span>📺</span><br><b>Cable TV</b></div>
<div class="card" onclick="alert('Electricity coming soon')"><span>⚡</span><br><b>Electricity</b></div>
</div>
<h2 style="padding:0 20px">Recent Activity</h2>
<div class="activity"><span>🟢 Wallet Funding<br><small>Demo transaction</small></span><b>+₦5,000</b></div>
<div class="activity"><span>🟠 Data Subscription<br><small>Demo transaction</small></span><b>-₦1,000</b></div>
</div>

<div id="data" class="page">
<h2>Buy Data</h2><p><b>Select Network</b></p>
<div id="nets"></div>
<p><b>Phone Number</b></p><input id="phone" placeholder="Enter phone number" maxlength="11">
<p><b>Select Data Plan</b></p><div id="plans"></div>
<button class="btn" style="margin-top:20px" onclick="buyData()">Continue</button>
</div>

<div id="history" class="page"><h2>Transaction History</h2><p>Your transactions will appear here.</p><div class="activity"><span>Wallet Funding</span><b>+₦5,000</b></div><div class="activity"><span>Data Subscription</span><b>-₦1,000</b></div></div>

<div id="profile" class="page"><h2>My Profile</h2><div style="text-align:center;font-size:50px">👤</div><h3 style="text-align:center">D-Pay User</h3><div class="card">👤 Personal Information</div><br><div class="card">🔒 Security</div><br><div class="card">❓ Help & Support</div><br><div class="card">⚙️ Settings</div></div>

<div class="nav">
<button class="active" onclick="showPage('home',this)">🏠 Home</button>
<button onclick="showPage('data',this)">📶 Data</button>
<button onclick="showPage('history',this)">🧾 History</button>
<button onclick="showPage('profile',this)">👤 Profile</button>
</div>

<script>
let network='MTN', selectedPlan='';
let plans={'MTN':['500MB - ₦500','1GB - ₦1,000','2GB - ₦2,000'],'Airtel':['500MB - ₦450','1GB - ₦900','2GB - ₦1,800'],'Glo':['1GB - ₦500','2GB - ₦1,000','5GB - ₦2,500'],'9mobile':['1GB - ₦1,000','2GB - ₦2,000']};
function render(){document.getElementById('nets').innerHTML=Object.keys(plans).map(n=>`<button class="chip ${n==network?'sel':''}" onclick="network='${n}';selectedPlan='';render()">${n}</button>`).join('');
document.getElementById('plans').innerHTML=plans[network].map(p=>`<div class="plan ${p==selectedPlan?'sel':''}" onclick="selectedPlan='${p}';render()">${p}</div>`).join('');}
function showPage(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);}
function buyData(){let ph=document.getElementById('phone').value;if(ph.length!=11||!selectedPlan){alert('Enter valid 11-digit number and select plan');return;}if(confirm('Network: '+network+'\nPhone: '+ph+'\nPlan: '+selectedPlan+'\n\nDemo only. No payment will be made.')){alert('Demo only. Connect real VTU API to purchase.');}}
render();
</script></body></html>
